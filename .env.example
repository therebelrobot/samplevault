# Copy to .env for local development:  cp .env.example .env
#
# Where your sample folders live. Relative paths resolve from the repo root.
# In the container this is /srv/samples and you bind-mount over it instead.
SAMPLES_DIR=./samples

# The UI store: packs, views, and name overrides. Small — keep it next to
# docker-compose.yml. The cache deliberately does not live here.
DB_PATH=./data/samplevault.json

# Remote audio and source indexes. This is the part that grows, so it defaults
# to the samples volume rather than alongside the db.
# CACHE_DIR=./samples/.cache

# The URL a browser will actually use to reach the samples, trailing slash
# required. Written into every manifest as _base, so it must be reachable from
# wherever Strudel is running — not from inside the container.
#
# For `npm run dev` this is the API's own port (3012), because the dev server
# serves the UI and audio itself. Behind nginx it is your public URL.
BASE_URL=http://localhost:3012/samples/

# --- optional, defaults shown ---
# NAME_SEP=_
# NAME_DEPTH=2      # trailing path segments used in a sound name; 0 = whole path
# EXTS=wav,mp3,ogg
# PORT=3012
# SERVE_STATIC=1    # dev server also serves the UI and audio; nginx handles it in prod
# UI_DIR=./ui
# WATCH=1
# DEBOUNCE_MS=500
# READ_ONLY=0      # 1 serves manifests and audio but rejects every write

# Remote sources. SOURCES_FILE defaults to <SAMPLES_DIR>/sources.json
# SOURCES_FILE=./data/sources.json
# REMOTE_TTL=86400
# GITHUB_TOKEN=
